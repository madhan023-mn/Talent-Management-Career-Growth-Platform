[Unit]
Description=Talent Growth - 24/7 Enterprise Talent Management Platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/talent-growth
EnvironmentFile=/var/www/talent-growth/.env
ExecStart=/var/www/talent-growth/.venv/bin/streamlit run app.py \
    --server.port=8501 \
    --server.address=127.0.0.1 \
    --server.headless=true \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false \
    --browser.gatherUsageStats=false \
    --client.toolbarMode=minimal

# Automatic crash recovery & process supervision
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s

# Security hardening
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
