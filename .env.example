# ==============================================================================
# Talent Growth Platform - Environment Configuration Template
# ==============================================================================

# Database Path
DATABASE_PATH=data/talentsphere.db

# Gemini AI Coaching API Key (Optional, falls back to rule-based engine if omitted)
GEMINI_API_KEY=

# Public Application Deployed URL (included in welcome emails)
APP_URL=https://talent-growth.vercel.app

# ==============================================================================
# Email Notification Service (SMTP) Credentials
# ==============================================================================
# Configure with any standard SMTP provider (Gmail, SendGrid, Amazon SES, Mailgun, etc.)
# If left blank, welcome email dispatch will be safely logged without crashing registration.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Talent Growth" <no-reply@talentgrowth.com>
SMTP_USE_TLS=true
